@model Binder

@{
    ViewData["Title"] = $"View Binder - {Model.Name}";
    var hasCover = Model.FrontCoverImage != null && Model.FrontCoverImage.Length > 0;
    var coverBase64 = hasCover ? Convert.ToBase64String(Model.FrontCoverImage) : "";
}

<style>
    .binder-viewer-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        width: 100%;
    }

    .binder-header {
        text-align: center;
        color: white;
        margin-bottom: 2rem;
        width: 100%;
    }

    .binder-header h1 {
        margin: 0;
        font-size: 2.5rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        color: white;
    }

    .binder-header p {
        margin: 0.5rem 0 0 0;
        font-size: 1.1rem;
        opacity: 0.95;
        color: white;
    }

    /* Standalone Cover View Styles */
    .binder-cover-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        perspective: 2000px;
        margin: 2rem 0;
        width: 680px;
        height: 480px;
        position: relative;
    }

    .binder-cover {
        width: 300px;
        height: 400px;
        background: linear-gradient(135deg, #4a569d 0%, #232531 100%);
        border-radius: 4px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: absolute;
        transform-style: preserve-3d;
        transform-origin: left center;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease;
        padding: 20px;
        text-align: center;
        color: white;
    }

    .binder-cover.shifting {
        transform: translateX(165px);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7);
    }

    .binder-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 4px;
    }

    .cover-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        border: 2px dashed rgba(255,255,255,0.3);
        border-radius: 4px;
        padding: 20px;
    }

    .open-binder-container {
        position: absolute;
        bottom: -20px;
        display: flex;
        gap: 1rem;
    }

    /* Active Open Book Display Area */
    .binder-display-area {
        display: none;
        flex-direction: column;
        align-items: center;
        width: 100%;
        animation: fadeIn 0.8s ease forwards;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .binder-display {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        perspective: 2000px;
    }

    .book-container {
        display: flex;
        gap: 0;
        background: linear-gradient(90deg, #1a1a1a 0%, #2a2a2a 50%, #1a1a1a 100%);
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        width: fit-content;
        position: relative;
        transform-style: preserve-3d;
    }

    .page-wrapper {
        width: 300px;
        height: 400px;
        position: relative;
        transform-style: preserve-3d;
    }

    .page {
        width: 100%;
        height: 100%;
        background-color: #3a3a3a;
        display: flex;
        position: absolute;
        top: 0;
        left: 0;
        overflow: visible;
        transform-style: preserve-3d;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), inset 1px 1px 0 rgba(255, 255, 255, 0.05);
    }

    #bgLeftPage, #bgRightPage { z-index: 1; }
    #leftPage, #rightPage { z-index: 3; }

    /* Flip animations */
    .page.flip-forward {
        animation: flipPageForward 1s ease-in-out forwards;
        transform-origin: left center;
        z-index: 10 !important;
    }

    .page.flip-backward {
        animation: flipPageBackward 1s ease-in-out forwards;
        transform-origin: right center;
        z-index: 10 !important;
    }

    @@keyframes flipPageForward {
        0% { transform: rotateY(0deg); }
        50% { transform: rotateY(-90deg); }
        100% { transform: rotateY(-180deg); }
    }

    @@keyframes flipPageBackward {
        0% { transform: rotateY(0deg); }
        50% { transform: rotateY(90deg); }
        100% { transform: rotateY(180deg); }
    }

    .page-content {
        width: 100%;
        height: 100%;
        padding: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transform-style: preserve-3d;
    }

    .page-content.un-mirror-forward { transform: rotateY(180deg); }
    .page-content.un-mirror-backward { transform: rotateY(-180deg); }

    .page-spine {
        position: absolute;
        width: 15px;
        height: 100%;
        background: linear-gradient(90deg, #1a1a1a 0%, #2a2a2a 100%);
        top: 0;
        z-index: 2;
    }

    .page-spine.left { left: 0; border-right: 1px solid rgba(0, 0, 0, 0.5); }
    .page-spine.right { right: 0; border-left: 1px solid rgba(0, 0, 0, 0.5); }

    .page-holes {
        position: absolute;
        height: 100%;
        width: 15px;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        padding: 15px 0;
        top: 0;
        left: 0;
    }

    .hole {
        width: 12px;
        height: 12px;
        background-color: #1a1a1a;
        border-radius: 50%;
        margin-left: 4px;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.8);
    }

    .card-grid {
        display: grid;
        gap: 12px;
        flex: 1;
        margin-left: 15px;
    }

    .card-grid.grid-2x2 { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); }
    .card-grid.grid-3x3 { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); }
    .card-grid.grid-4x4 { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(4, 1fr); }
    .card-grid.grid-single { grid-template-columns: 1fr; grid-template-rows: 1fr; }

    .card-slot {
        background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
        border: 2px solid #999;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        aspect-ratio: 2.5 / 3.5;
    }

    .card-slot:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        border-color: #667eea;
    }

    .card-slot.filled { border-color: #666; padding: 2px; }
    .card-slot.filled img { width: 100%; height: 100%; object-fit: cover; border-radius: 2px; }

    .card-slot.empty {
        background: linear-gradient(135deg, #e8e8e8 0%, #d0d0d0 100%);
        color: #999;
        font-size: 0.8rem;
        text-align: center;
        padding: 10px;
    }

    .card-slot-placeholder { font-size: 0.75rem; color: #bbb; text-align: center; z-index: 1; }

    .page-number {
        text-align: center;
        color: #888;
        font-size: 0.9rem;
        padding-top: 10px;
        border-top: 1px solid #444;
        margin-left: 15px;
    }

    .inner-cover-inner, .front-cover-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        color: white;
        margin-left: 15px;
    }

    .front-cover-inner {
        background: linear-gradient(135deg, #4a569d 0%, #232531 100%);
        border-radius: 4px;
        margin-left: 0;
        width: 100%;
        height: 100%;
        padding: 20px;
    }

    .page-navigation {
        display: flex;
        justify-content: center;
        gap: 2rem;
        align-items: center;
    }

    .page-counter { color: white; font-weight: 600; min-width: 200px; text-align: center; }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.3s ease;
        color: white;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary { background-color: #667eea; }
    .btn-primary:hover { background-color: #5568d3; transform: translateY(-2px); }
    .btn-secondary { background-color: #764ba2; }
    .btn-secondary:hover { background-color: #63398b; transform: translateY(-2px); }
    .btn-success { background-color: #28a745; }
    .btn-success:hover { background-color: #218838; transform: translateY(-2px); }
    .btn:disabled { background-color: #999; cursor: not-allowed; transform: none; }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
    }
    .modal.show { display: flex; align-items: center; justify-content: center; }
    .modal-content {
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        max-height: 80vh;
        overflow-y: auto;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ddd;
    }
    .modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999; }
    .card-select {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .card-option {
        border: 2px solid #ddd;
        border-radius: 4px;
        padding: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        background-color: #f9f9f9;
    }
    .card-option.selected { border-color: #667eea; background-color: #e0e7ff; }
</style>

<div class="binder-viewer-container" id="binderContainer" data-binder-id="@Model.Id">
    <div class="binder-header">
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        <p>Design: @Model.BinderDesign | Total Pages: @Model.Pages.Count</p>
    </div>

    <!-- Standalone Front Cover View State -->
    <div class="binder-cover-wrapper" id="binderCoverWrapper">
        <div class="binder-cover" id="binderCover">
            @if (hasCover)
            {
                <img src="data:image/png;base64,@coverBase64" alt="Front Cover" />
            }
            else
            {
                <div class="cover-placeholder">
                    <h2>@Model.Name</h2>
                    <p style="opacity: 0.9;">@Model.BinderDesign Binder</p>
                </div>
            }
        </div>
        <div class="open-binder-container">
            <button class="btn btn-success" onclick="openBinderCover()">📖 Open Binder</button>
            <a href="/Binder/Index" class="btn btn-primary" style="margin-left: 1rem;">Back to Binders</a>
        </div>
    </div>

    <!-- Active Open Book Display State -->
    <div class="binder-display-area" id="binderDisplayArea">
        @if (Model.Pages != null && Model.Pages.Count > 0)
        {
            <div class="binder-display">
                <div class="book-container">
                    <!-- Left Page Wrapper -->
                    <div class="page-wrapper">
                        <div class="page" id="bgLeftPage">
                            <div class="page-content" id="bgLeftPageContent"></div>
                            <div class="page-spine right">
                                <div class="page-holes">
                                    @for(int i=0; i<7; i++){<div class="hole"></div>}
                                </div>
                            </div>
                        </div>
                        <div class="page" id="leftPage">
                            <div class="page-content" id="leftPageContent"></div>
                            <div class="page-spine right">
                                <div class="page-holes">
                                    @for(int i=0; i<7; i++){<div class="hole"></div>}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Page Wrapper -->
                    <div class="page-wrapper">
                        <div class="page" id="rightPage">
                            <div class="page-spine left">
                                <div class="page-holes">
                                    @for(int i=0; i<7; i++){<div class="hole"></div>}
                                </div>
                            </div>
                            <div class="page-content" id="rightPageContent"></div>
                        </div>
                        <div class="page" id="bgRightPage">
                            <div class="page-spine left">
                                <div class="page-holes">
                                    @for(int i=0; i<7; i++){<div class="hole"></div>}
                                </div>
                            </div>
                            <div class="page-content" id="bgRightPageContent"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-navigation">
                <button class="btn btn-secondary" id="prevBtn" onclick="previousPage()">← Previous Page</button>
                <div class="page-counter" id="pageInfo">Inside Cover - Page 1 of @Model.Pages.Count</div>
                <button class="btn btn-secondary" id="nextBtn" onclick="nextPage()">Next Page →</button>
            </div>

            <div class="action-buttons">
                <button class="btn btn-success" onclick="openAddPageModal()">+ Add Page</button>
                <button class="btn btn-secondary" onclick="closeBinder()">🔒 Close Binder</button>
                <a href="/Binder/Index" class="btn btn-primary">Back to Binders</a>
            </div>
        }
        else
        {
            <div style="color: white; text-align: center; padding: 2rem;">
                <p>No pages in this binder yet.</p>
                <button class="btn btn-success" onclick="openAddPageModal()" style="margin-top: 1rem;">+ Add First Page</button>
                <button class="btn btn-secondary" onclick="closeBinder()" style="margin-top: 1rem;">🔒 Close Binder</button>
            </div>
        }
    </div>
</div>

<!-- Add Page Modal -->
<div id="addPageModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Add New Page</h2>
            <button class="modal-close" onclick="closeAddPageModal()">&times;</button>
        </div>
        <form id="addPageForm" onsubmit="submitAddPage(event)">
            <label for="gridSize" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Grid Layout</label>
            <select id="gridSize" name="gridSize" required style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 1rem;">
                <option value="1">Single Slot</option>
                <option value="4">2x2 Grid (4 Cards)</option>
                <option value="9">3x3 Grid (9 Cards)</option>
                <option value="16">4x4 Grid (16 Cards)</option>
            </select>
            <button type="submit" class="btn btn-success" style="width: 100%; margin-top: 1rem;">Add Page</button>
        </form>
    </div>
</div>

<!-- Add Card to Slot Modal -->
<div id="addCardModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Select Card for Slot</h2>
            <button class="modal-close" onclick="closeAddCardModal()">&times;</button>
        </div>
        <div id="cardSelectContainer"><p>Loading cards...</p></div>
        <div style="margin-top: 1rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="flex: 1;" onclick="submitAddCard()">Add Card</button>
            <button class="btn btn-secondary" style="flex: 1;" onclick="closeAddCardModal()">Cancel</button>
        </div>
    </div>
</div>

<script type="application/json" id="pagesData">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pages))
</script>

<script>
    let binderId = 0;
    let pages = [];
    let currentSpreadIndex = 0; 
    let selectedSlotId = null;
    let selectedCardId = null;
    let isAnimating = false;

    const hasFrontCover = @Json.Serialize(hasCover);
    const coverBase64 = @Json.Serialize(coverBase64);
    const binderName = @Json.Serialize(Model.Name);
    const binderDesign = @Json.Serialize(Model.BinderDesign);

    function initializeData() {
        const container = document.querySelector('[data-binder-id]');
        if (container) binderId = parseInt(container.getAttribute('data-binder-id'));
        
        const pagesDataElement = document.getElementById('pagesData');
        if (pagesDataElement && pagesDataElement.textContent) {
            try {
                pages = JSON.parse(pagesDataElement.textContent);
            } catch (e) {
                console.error('Failed to parse pages JSON:', e);
            }
        }
    }

    function renderSinglePage(contentElementId, page) {
        let pageContent = document.getElementById(contentElementId);
        if (!pageContent) return;
        pageContent.innerHTML = '';
        
        if (!page) {
            pageContent.innerHTML = '<div class="page-number" style="margin-top: auto; width: 100%;"></div>';
            return;
        }
        
        const cardGrid = document.createElement('div');
        cardGrid.className = `card-grid ${getGridSizeClass(page.GridSize)}`;
        
        if (page.Slots && Array.isArray(page.Slots)) {
            page.Slots.forEach((slot) => {
                const slotDiv = document.createElement('div');
                slotDiv.className = 'card-slot';
                slotDiv.id = `slot-${slot.Id}`;
                slotDiv.onclick = (e) => {
                    e.stopPropagation();
                    openAddCardModal(slot.Id);
                };
                
                if (slot.CardId) {
                    slotDiv.classList.add('filled');
                    slotDiv.innerHTML = `<img src="/Card/GetImage/${slot.CardId}" alt="Card" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22140%22%3E%3Crect fill=%22%23ddd%22 width=%22100%22 height=%22140%22/%3E%3C/svg%3E'" />`;
                } else {
                    slotDiv.classList.add('empty');
                    slotDiv.innerHTML = '<span class="card-slot-placeholder">Empty Slot</span>';
                }
                cardGrid.appendChild(slotDiv);
            });
        }
        pageContent.appendChild(cardGrid);
        
        let pageNum = document.createElement('div');
        pageNum.className = 'page-number';
        pageNum.textContent = `Page ${page.PageNumber}`;
        pageContent.appendChild(pageNum);
    }

    function renderOpeningUnderneath() {
        // Step 2: Render ONLY Page 1 on the right side underneath the cover, left side empty
        let leftContent = document.getElementById('leftPageContent');
        if (leftContent) leftContent.innerHTML = '<div class="page-number" style="margin-top: auto; width: 100%;"></div>';
        
        renderSinglePage('rightPageContent', pages[0] || null);
    }

    function openBinderCover() {
        const cover = document.getElementById('binderCover');
        
        // Step 1: Shift cover right into position for the right-hand page
        cover.classList.add('shifting');

        // Step 2: Once shift completes (600ms), reveal display area and render Page 1 underneath
        setTimeout(() => {
            document.getElementById('binderCoverWrapper').style.display = 'none';
            document.getElementById('binderDisplayArea').style.display = 'flex';

            if (pages.length > 0) {
                renderOpeningUnderneath();
            }

            // Step 3: Put front cover into rightPage element to execute the open flip animation
            renderFrontCover('rightPageContent');
            const rightPage = document.getElementById('rightPage');
            rightPage.classList.add('flip-forward');

            // Step 4: Midpoint (500ms into flip) - transition into Inside Cover on left / un-mirror
            setTimeout(() => {
                renderInnerCover('rightPageContent');
                const rightContent = document.getElementById('rightPageContent');
                if (rightContent) rightContent.classList.add('un-mirror-forward');
            }, 500);

            // Completion (1000ms into flip)
            setTimeout(() => {
                rightPage.classList.remove('flip-forward');
                renderPageSpread(0);
                isAnimating = false;
            }, 1000);

        }, 600);
    }

    function closeBinder() {
        document.getElementById('binderDisplayArea').style.display = 'none';
        const coverWrapper = document.getElementById('binderCoverWrapper');
        coverWrapper.style.display = 'flex';
        const cover = document.getElementById('binderCover');
        cover.classList.remove('shifting', 'opening');
        currentSpreadIndex = 0;
    }

    function getGridSizeClass(gridSize) {
        switch(gridSize) {
            case 1: return 'grid-single';
            case 4: return 'grid-2x2';
            case 9: return 'grid-3x3';
            case 16: return 'grid-4x4';
            default: return 'grid-4x4';
        }
    }

    function renderFrontCover(contentElementId) {
        let pageContent = document.getElementById(contentElementId);
        if (!pageContent) return;
        
        if (hasFrontCover) {
            pageContent.innerHTML = `
                <div class="front-cover-inner" style="background: none; padding: 0;">
                    <img src="data:image/png;base64,${coverBase64}" alt="Front Cover" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" />
                </div>
            `;
        } else {
            pageContent.innerHTML = `
                <div class="front-cover-inner">
                    <h2>${binderName}</h2>
                    <p style="opacity: 0.9;">${binderDesign} Binder</p>
                </div>
            `;
        }
    }

    function renderInnerCover(contentElementId) {
        let pageContent = document.getElementById(contentElementId);
        if (!pageContent) return;
        pageContent.innerHTML = `
            <div class="inner-cover-inner">
                <h2>${binderName}</h2>
                <p style="color: #aaa; margin-top: 0.5rem;">Inside Front Cover</p>
                <div class="page-number" style="margin-top: auto; width: 100%;">Inside Cover</div>
            </div>
        `;
    }

    function renderPageSpread(spreadIndex) {
        currentSpreadIndex = spreadIndex;
        
        const rightContent = document.getElementById('rightPageContent');
        const leftContent = document.getElementById('leftPageContent');
        if (rightContent) rightContent.className = 'page-content';
        if (leftContent) leftContent.className = 'page-content';

        if (spreadIndex === 0) {
            renderInnerCover('leftPageContent');
            renderSinglePage('rightPageContent', pages[0]);
            renderSinglePage('bgLeftPageContent', null);
            renderSinglePage('bgRightPageContent', pages[1] || null);
        } else {
            let leftIdx = (spreadIndex - 1) * 2 + 1;
            let rightIdx = (spreadIndex - 1) * 2 + 2;
            let nextLeftIdx = spreadIndex * 2 + 1;
            let nextRightIdx = spreadIndex * 2 + 2;

            renderSinglePage('leftPageContent', pages[leftIdx] || null);
            renderSinglePage('rightPageContent', pages[rightIdx] || null);
            renderSinglePage('bgLeftPageContent', pages[nextLeftIdx] || null);
            renderSinglePage('bgRightPageContent', pages[nextRightIdx] || null);
        }

        updatePageCounter();
    }

    function nextPage() {
        if (isAnimating) return;
        
        let maxSpread = Math.ceil(pages.length / 2);
        if (currentSpreadIndex >= maxSpread) return;

        isAnimating = true;
        let targetSpread = currentSpreadIndex + 1;

        let lIdx = (targetSpread - 1) * 2 + 1;
        let rIdx = (targetSpread - 1) * 2 + 2;
        renderSinglePage('bgLeftPageContent', pages[lIdx] || null);
        renderSinglePage('bgRightPageContent', pages[rIdx] || null);

        const rightPage = document.getElementById('rightPage');
        rightPage.classList.add('flip-forward');

        setTimeout(() => {
            // Midpoint: Turning page lands on the left, so its back must show the target left page (lIdx)
            renderSinglePage('rightPageContent', pages[lIdx] || null);
            const rightContent = document.getElementById('rightPageContent');
            if (rightContent) rightContent.classList.add('un-mirror-forward');
        }, 500);

        setTimeout(() => {
            rightPage.classList.remove('flip-forward');
            renderPageSpread(targetSpread);
            isAnimating = false;
        }, 1000);
    }

    function previousPage() {
        if (isAnimating) return;
        
        if (currentSpreadIndex === 0) {
            closeBinder();
            return;
        }

        isAnimating = true;
        let targetSpread = currentSpreadIndex - 1;

        if (targetSpread === 0) {
            renderSinglePage('bgLeftPageContent', null);
            renderSinglePage('bgRightPageContent', pages[0] || null);
        } else {
            let lIdx = (targetSpread - 1) * 2 + 1;
            let rIdx = (targetSpread - 1) * 2 + 2;
            renderSinglePage('bgLeftPageContent', pages[lIdx] || null);
            renderSinglePage('bgRightPageContent', pages[rIdx] || null);
        }

        const leftPage = document.getElementById('leftPage');
        leftPage.classList.add('flip-backward');

        setTimeout(() => {
            // Midpoint: Turning page lands on the right, so its back must show the target right page (rIdx or pages[0] for spread 0)
            if (targetSpread === 0) {
                renderSinglePage('leftPageContent', pages[0] || null);
            } else {
                let rIdx = (targetSpread - 1) * 2 + 2;
                renderSinglePage('leftPageContent', pages[rIdx] || null);
            }
            const leftContent = document.getElementById('leftPageContent');
            if (leftContent) leftContent.classList.add('un-mirror-backward');
        }, 500);

        setTimeout(() => {
            leftPage.classList.remove('flip-backward');
            renderPageSpread(targetSpread);
            isAnimating = false;
        }, 1000);
    }

    function updatePageCounter() {
        let pageInfoEl = document.getElementById('pageInfo');
        if (pageInfoEl) {
            if (currentSpreadIndex === 0) {
                let p1 = pages.length > 0 ? `Page 1` : '';
                pageInfoEl.textContent = `Inside Cover - ${p1} of ${pages.length}`;
            } else {
                let lIdx = (currentSpreadIndex - 1) * 2 + 1;
                let rIdx = (currentSpreadIndex - 1) * 2 + 2;
                let lNum = pages[lIdx] ? pages[lIdx].PageNumber : '';
                let rNum = pages[rIdx] ? pages[rIdx].PageNumber : '';
                pageInfoEl.textContent = rNum ? `Pages ${lNum}-${rNum} of ${pages.length}` : `Page ${lNum} of ${pages.length}`;
            }
        }
        
        let maxSpread = Math.ceil(pages.length / 2);
        document.getElementById('nextBtn').disabled = currentSpreadIndex >= maxSpread;
    }

    function openAddPageModal() { document.getElementById('addPageModal').classList.add('show'); }
    function closeAddPageModal() { document.getElementById('addPageModal').classList.remove('show'); }
    
    function submitAddPage(event) {
        event.preventDefault();
        const gridSize = document.getElementById('gridSize').value;
        fetch(`/Binder/AddPage?binderId=${binderId}&gridSize=${gridSize}`, { method: 'POST' })
            .then(response => { if (response.ok) location.reload(); });
    }

    function openAddCardModal(slotId) {
        selectedSlotId = slotId;
        selectedCardId = null;
        document.getElementById('addCardModal').classList.add('show');
        loadCards();
    }

    function closeAddCardModal() {
        document.getElementById('addCardModal').classList.remove('show');
        selectedSlotId = null;
        selectedCardId = null;
    }

    function loadCards() {
        fetch('/Card/GetAllCards')
            .then(response => response.json())
            .then(cards => {
                const container = document.getElementById('cardSelectContainer');
                if (cards.length === 0) {
                    container.innerHTML = '<p>No cards available. <a href="/Card/Create">Create a card first.</a></p>';
                    return;
                }
                let html = '<div class="card-select">';
                cards.forEach(card => {
                    html += `<div class="card-option" onclick="selectCard(${card.id})" id="card-${card.id}">
                        <div style="font-size: 0.8rem; font-weight: 600;">${card.name}</div>
                        <div style="font-size: 0.7rem; color: #999;">${card.packName || 'N/A'}</div>
                    </div>`;
                });
                html += '</div>';
                container.innerHTML = html;
            });
    }

    function selectCard(cardId) {
        selectedCardId = cardId;
        document.querySelectorAll('.card-option').forEach(el => el.classList.remove('selected'));
        document.getElementById(`card-${cardId}`).classList.add('selected');
    }

    function submitAddCard() {
        if (!selectedSlotId || !selectedCardId) { alert('Please select a card'); return; }
        fetch(`/Binder/AddCardToSlot?slotId=${selectedSlotId}&cardId=${selectedCardId}`, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeAddCardModal();
                    renderPageSpread(currentSpreadIndex);
                } else {
                    alert('Error adding card to slot');
                }
            });
    }

    // Expose functions globally for inline onclick handlers
    window.openBinderCover = openBinderCover;
    window.closeBinder = closeBinder;
    window.nextPage = nextPage;
    window.previousPage = previousPage;
    window.openAddPageModal = openAddPageModal;
    window.closeAddPageModal = closeAddPageModal;
    window.submitAddPage = submitAddPage;
    window.openAddCardModal = openAddCardModal;
    window.closeAddCardModal = closeAddCardModal;
    window.submitAddCard = submitAddCard;
    window.selectCard = selectCard;

    document.addEventListener('keydown', (e) => {
        const coverWrapper = document.getElementById('binderCoverWrapper');
        if (coverWrapper.style.display !== 'none') {
            if (e.key === 'Enter' || e.key === 'ArrowRight') openBinderCover();
        } else {
            if (e.key === 'ArrowLeft') previousPage();
            if (e.key === 'ArrowRight') nextPage();
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        initializeData();
    });
</script>